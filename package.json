{
  "name": "kingdom",
  "version": "0.3.0",
  "description": "The reward system for dingn games: account XP and levels, honors, badge coins, the coin ledger, and the 3D kingdom players build with their coins.",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "assets"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    "./rewards": {
      "types": "./src/rewards.d.mts",
      "default": "./src/rewards.mjs"
    },
    "./levels": {
      "types": "./src/levels.d.mts",
      "default": "./src/levels.mjs"
    },
    "./honors": {
      "types": "./src/honors.d.mts",
      "default": "./src/honors.mjs"
    },
    "./coins": {
      "types": "./src/coins.d.mts",
      "default": "./src/coins.mjs"
    },
    "./ledger": {
      "types": "./src/ledger.d.mts",
      "default": "./src/ledger.mjs"
    },
    "./kingdom": {
      "types": "./src/kingdom.d.mts",
      "default": "./src/kingdom.mjs"
    },
    "./rules": {
      "types": "./src/rules.d.mts",
      "default": "./src/rules.mjs"
    },
    "./scene": "./src/scene/kingdom-scene.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/mount": "./src/ui/mount.tsx",
    "./ui/kingdom.css": "./src/ui/kingdom.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.187.0",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.187.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
